  "cards": [
    {
      "dot": "cyan",
      "title": "v1 scope",
      "items": [
        "Banks license type only; gap analysis runs as a batch once all RFI files are submitted",
        "Notice Corpus + Audit Trail Store are one physical \"Fraud Database\"; logical separation kept for citation-grounding and audit guarantees",
        "Further-submission documents from Phase 2 loop back into Phase 1's Intake Tracker (not drawn — same shared workspace path)"
      ]
    },
    {
      "dot": "violet",
      "title": "Human-in-the-loop",
      "items": [
        "Supervision-question list, findings/severity, and pre-AG submission require Lead/Approver sign-off",
        "AG-requested changes and LFI pre-exit concerns are routine revision loops back into Findings & Reporting, not rare edge cases",
        "Ungrounded compliance verdicts fall back to human review, never a guess"
      ]
    },
    {
      "dot": "emerald",
      "title": "Deferred to v2",
      "items": [
        "Content/plausibility validation agent",
        "Unified cross-feature review queue",
        "Effective-dated notice versions and SVF/other license types"
      ]
    }
  ]
