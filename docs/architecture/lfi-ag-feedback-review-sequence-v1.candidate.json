{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "AG Feedback Review — Redraft Guardrail Call Sequence",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "viewBox": [1050, 900],
    "legend": {
      "mode": "all",
      "entries": {
        "default": { "label": "UI action / tool call" },
