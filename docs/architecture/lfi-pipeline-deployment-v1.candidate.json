  "cards": [
    {
      "dot": "cyan",
      "title": "5 agents, 1 deployable service",
      "items": [
        "Intake Tracker, Gap Analysis, Clarification & Meeting, Findings & Reporting, and AG & Pre-Exit run as one LangGraph process (shared runtime), but are 5 distinct nodes with independent prompts, tools, and guardrails",
        "Intake Tracker is rule-based, not an LLM agent (labeled on its box)",
        "Persona shown on each box; hover/zoom reveals its guardrail. Full detail: agent-specifications.md"
      ]
    },
    {
      "dot": "violet",
      "title": "Shared dependencies (not all arrows drawn)",
      "items": [
        "Every agent calls LLM Inference Service — only Clarification & Meeting's call is drawn as representative",
        "Every agent persists state to the Fraud Database after each step (audit trail, decision 36) — only Findings & Reporting's write is drawn as representative"
      ]
    },
    {
      "dot": "emerald",
      "title": "Deployment decisions (ADR-0013/0014/0015)",
      "items": [
        "On-prem for now; LLM self-hosted with Qwen Coder / gpt-oss-120b as candidates behind a swappable interface",
        "Identity federates to CBUAE's existing SSO; Fraud Database is Oracle, isolated in its own subnet"
      ]
    }
